model: pha;

#define g 9.8
[0, 10000] Sx; // horizontal distance (m)
[0, 1000] Sy; // vertical distance (m)
[0, 10] tau; // local time
[0, 2] time; // local time (required)
[0, 500] v; // speed of the ball (m/s)
dist_normal(25,1) v0; // initial speed of the ball (m)
dist_discrete(0.7854:0.9,1.0472:0.09,0.5236:0.01) alpha; // angle to horizon (rad)

[0, 1000] noise_std;

{
mode 1;

flow:
    d/dt[Sx]= v * cos(alpha);
    d/dt[Sy]= v * sin(alpha) - g * tau;
    d/dt[tau]= 1.0;
    d/dt[v] = 0.0;


jump:
(and (tau >= 0.1)) ==> @1 (and (Sx' = Sx + dist_normal(0, noise_std)) 
                               (Sy' = Sy) 
                               (v' = v) 
                               (tau' = 0) 
                               (v0' = v0) 
                               (alpha' = alpha));

(and (tau > 1e-3) (Sy <= 0)(Sy >= 0)) ==> @1(and (Sx' = Sx)
						(Sy' = 0)
						(tau' = 0)
						(v' = 0.7 * v)
						(v0' = v0)
						(alpha' = alpha));
}

init:
@1(and (Sx = 0) (Sy = 1e-3) (tau = 0) (v = 25));

goal:
@1(and (tau > 0) (Sx >= 10));
